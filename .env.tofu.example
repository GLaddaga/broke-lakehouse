# The admin credentials tofu runs with: names only. Copy to .env.tofu (gitignored)
# and fill in. Plain KEY=VALUE lines. The Prefect pair stays in .env.prefect.
# @docs/infrastructure.md

# Tigris admin key, "Default allowed operations" off. Also opens the state bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NEON_API_KEY=
# Organization settings → General, `org-…`. Required unless the key belongs to a
# single personal account.
TF_VAR_neon_org_id=

# Infisical org-level machine identity, role Admin, Universal Auth.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
TF_VAR_infisical_org_id=
# Only for an organization in the EU region:
# TF_VAR_infisical_host=https://eu.infisical.com

# Encrypts the state. Keep a copy in a password manager: without it the state is lost.
TF_VAR_state_passphrase=
